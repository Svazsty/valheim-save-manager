<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Valheim Save Manager 0.1.1" Width="448" Height="448" MinWidth="432" MinHeight="432"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#101113" Foreground="#D9DADD" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">12</system:Double>
    <SolidColorBrush x:Key="Muted" Color="#A3A6AD"/>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Background="Transparent"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollHandle" TargetType="Thumb">
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border x:Name="Handle" Margin="3,0" CornerRadius="3" Background="#484D55"/>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#6B737F"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#939DAA"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ScrollHandle}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="CanContentScroll" Value="False"/>
      <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>
    <Style x:Key="TrafficLight" TargetType="Button">
      <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#252629"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"/><ContentPresenter x:Name="Symbol" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1"/><Setter TargetName="Dot" Property="Stroke" Value="White"/><Setter TargetName="Dot" Property="StrokeThickness" Value="1"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="0.6"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D9DADD"/>
      <Setter Property="Background" Value="#1B1D20"/>
      <Setter Property="BorderBrush" Value="#303237"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#292C31"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34383E"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B9BDC5"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101113"/><Setter Property="Foreground" Value="#D9DADD"/>
      <Setter Property="BorderBrush" Value="#4A4D54"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#555D70"/>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#303237" BorderThickness="1" CornerRadius="11" Padding="24,0,24,18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,-12,0">
        <TextBlock Text="Valheim Save Manager · 0.1.1" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="55,0,30,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="CloseButton" Style="{StaticResource TrafficLight}" Background="#DF7770" Content="×" ToolTip="Zamknij" AutomationProperties.Name="Zamknij"/>
          <Button x:Name="MinimizeButton" Style="{StaticResource TrafficLight}" Background="#D3B46E" Content="−" ToolTip="Minimalizuj" AutomationProperties.Name="Minimalizuj"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource TrafficLight}" Background="#83AE89" Content="+" ToolTip="Maksymalizuj / przywróć" AutomationProperties.Name="Maksymalizuj lub przywróć"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="MainView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,16,0,18">
          <TextBlock Text="Twój świat. Zawsze pod ręką." FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Pobierz przed grą. Wyślij, gdy skończysz." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="WorldSettingsButton" HorizontalContentAlignment="Stretch" Padding="16,15" ToolTip="Zmień wybrany świat" AutomationProperties.Name="Wybierz świat w ustawieniach">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="9" Background="#292C30" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BFC4CC"/>
              </Border>
              <StackPanel Grid.Column="1"><TextBlock Text="SELECTED WORLD" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WorldLabel" Text="NewWorld" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </Grid>
          </Button>
          <Grid Margin="2,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LocalLabel" Text="Local  ·  sprawdzanie" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Grid.Column="1" x:Name="DriveLabel" Text="Drive  ·  sprawdzanie" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="DownloadButton" Height="76" AutomationProperties.Name="Download World" Background="#272A2E">
            <StackPanel><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,0,9" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Download World" FontSize="12" FontWeight="Medium"/></StackPanel>
          </Button>
          <Button Grid.Column="2" x:Name="UploadButton" Height="76" AutomationProperties.Name="Upload World">
            <StackPanel><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Margin="0,0,0,9" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Upload World" FontSize="12" FontWeight="Medium"/></StackPanel>
          </Button>
        </Grid>
        <ProgressBar Grid.Row="3" x:Name="BusyBar" Height="3" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#9299A5" Background="#1B1D20" BorderThickness="0"/>
        <ScrollViewer x:Name="StatusScroll" Grid.Row="4" Margin="1,18,0,12">
          <StackPanel>
            <TextBlock x:Name="StatusLabel" Text="Gotowy do synchronizacji." TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="SuccessLabel" Text="Brak udanych operacji na tym komputerze." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="5">
          <TextBlock Text="Google Drive for desktop" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Padding="9" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" ToolTip="Ustawienia (Ctrl+,)" AutomationProperties.Name="Ustawienia"/>
        </Grid>
      </Grid>
      <Grid Grid.Row="1" x:Name="SettingsView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,18"/>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1">
          <StackPanel>
            <Label Content="_World name" Target="{Binding ElementName=WorldInput}" Foreground="#A3A6AD" Padding="0,0,0,6"/>
            <TextBox x:Name="WorldInput" AutomationProperties.Name="World name" Margin="0,0,0,15"/>
            <Label Content="_Google Drive folder" Target="{Binding ElementName=DriveInput}" Foreground="#A3A6AD" Padding="0,0,0,6"/>
            <TextBox x:Name="DriveInput" AutomationProperties.Name="Google Drive folder" Margin="0,0,0,7"/>
            <Button x:Name="BrowseButton" Content="Wybierz folder..." HorizontalAlignment="Left" Padding="10,7" Margin="0,0,0,15"/>
            <TextBlock Text="Lokalne zapisy Valheim" Foreground="{StaticResource Muted}" FontSize="11"/>
            <TextBlock x:Name="WorldPathLabel" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,12"/>
            <Button x:Name="BackupsButton" Content="Otwórz folder backupów" Padding="10,8" HorizontalAlignment="Left"/>
            <TextBlock x:Name="SettingsError" Foreground="#E3B6AF" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Button x:Name="CancelSettingsButton" Content="Anuluj" HorizontalAlignment="Left" Padding="15,9"/>
          <Button x:Name="SaveSettingsButton" Content="Zapisz" HorizontalAlignment="Right" Padding="20,9"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
